# ---- PostgreSQL ----
POSTGRES_USER=et_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=english_teachers
DATABASE_URL=postgresql://et_user:change_me@postgres:5432/english_teachers?schema=public

# ---- Umumiy ----
NODE_ENV=development

# ---- Domen (production: HTTPS + WebSocket uchun; Caddy ishlatadi) ----
# .uz domeningiz, masalan: markazingiz.uz
DOMAIN=example.uz

# ---- JWT (production'da kamida 32 belgidan iborat tasodifiy sir!) ----
JWT_SECRET=change_me_to_a_long_random_secret_string_min_32_chars
JWT_EXPIRES_IN=7d

# ---- Super admin (production'da kuchli parol majburiy) ----
SUPERADMIN_LOGIN=superadmin
SUPERADMIN_PASSWORD=change_me
SUPERADMIN_FIRSTNAME=Super
SUPERADMIN_LASTNAME=Admin
SUPERADMIN_PHONE=+998 90 000 00 00
# Parolni unutib qo'ysangiz true qilib, backendni qayta ishga tushiring (keyin false)
SUPERADMIN_RESET_PASSWORD=false

# ---- Fayllar va limitlar ----
UPLOAD_DIR=/app/uploads
MAX_VIDEO_SIZE_MB=200
MAX_ATTACHMENT_SIZE_MB=10
MAX_AVATAR_SIZE_MB=5

# ---- CORS va boshqa ----
CORS_ORIGIN=http://localhost:5173
LESSON_REMINDER_MINUTES=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_BLOCK_MINUTES=5

# ---- Frontend ----
VITE_API_URL=http://localhost:3000
